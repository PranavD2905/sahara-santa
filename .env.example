# Neon Postgres (pooled connection string). Provision via the Vercel Marketplace.
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 in development; the production URL on Vercel.
# Production: your domain. Preview: leave unset (each preview uses its own URL).
BETTER_AUTH_URL=http://localhost:3000

# Optional in development: without it, emails are printed to the server console.
RESEND_API_KEY=
# Must be on a domain verified in Resend before inviting real users.
EMAIL_FROM="Sahara Santa <onboarding@resend.dev>"

# Private Vercel Blob for pictures. Optional in development: files go to ./.data/uploads.
BLOB_READ_WRITE_TOKEN=
